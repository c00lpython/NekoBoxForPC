{
  "vless": {
    "description": "VLESS — легковесный производительный протокол без шифрования полезной нагрузки",
    "properties": {
      "server": { "type": "string", "description": "Адрес сервера (IPv4, IPv6 или домен)", "default": "127.0.0.1" },
      "server_port": { "type": "u16", "description": "Порт сервера", "default": 443 },
      "uuid": { "type": "string", "description": "UUID пользователя (идентификатор клиента)", "default": "" },
      "flow": { "type": "string", "description": "Flow управления потоком (xtls-rprx-vision или пусто)", "default": "xtls-rprx-vision" },
      "packet_encoding": { "type": "string", "description": "Кодирование UDP пакетов (xudp, packetaddr или пусто)", "default": "xudp" },
      "network": { "type": "string", "description": "Сетевой транспорт (tcp, udp)", "default": "tcp" },
      "security": { "type": "string", "description": "Схема безопасности (none, tls, reality)", "default": "reality" },
      "sni": { "type": "string", "description": "SNI (Server Name Indication для TLS/Reality)", "default": "" },
      "insecure": { "type": "bool", "description": "Разрешить недоверенные/самоподписанные сертификаты", "default": false },
      "alpn": { "type": "array", "description": "Список ALPN протоколов (например: [\"h2\", \"http/1.1\"])", "default": ["h2", "http/1.1"] },
      "reality_public_key": { "type": "string", "description": "Публичный ключ Reality (Reality Public Key)", "default": "" },
      "reality_short_id": { "type": "string", "description": "Short ID для Reality (шестнадцатеричный идентификатор)", "default": "" },
      "transport_type": { "type": "string", "description": "Тип транспорта (tcp, ws, grpc, httpupgrade)", "default": "tcp" },
      "transport_path": { "type": "string", "description": "Путь для WebSocket или HTTPUpgrade (Path)", "default": "/" },
      "transport_service_name": { "type": "string", "description": "Имя gRPC сервиса (Service Name)", "default": "" }
    }
  },
  "vmess": {
    "description": "VMess — классический протокол V2Ray с собственным шифрованием пакетов",
    "properties": {
      "server": { "type": "string", "description": "Адрес сервера (IP или домен)", "default": "127.0.0.1" },
      "server_port": { "type": "u16", "description": "Порт сервера", "default": 443 },
      "uuid": { "type": "string", "description": "UUID пользователя", "default": "" },
      "alter_id": { "type": "u16", "description": "AlterId (рекомендуется 0 для AEAD)", "default": 0 },
      "security": { "type": "string", "description": "Шифрование полезной нагрузки (auto, aes-128-gcm, chacha20-poly1305, none)", "default": "auto" },
      "packet_encoding": { "type": "string", "description": "Кодирование UDP пакетов (xudp или пусто)", "default": "xudp" },
      "tls_enabled": { "type": "bool", "description": "Включить TLS шифрование", "default": true },
      "sni": { "type": "string", "description": "SNI (Server Name Indication)", "default": "" },
      "transport_type": { "type": "string", "description": "Тип транспорта (tcp, ws, grpc, httpupgrade)", "default": "ws" },
      "transport_path": { "type": "string", "description": "Путь запроса WebSocket (Path)", "default": "/" }
    }
  },
  "trojan": {
    "description": "Trojan — протокол имитации защищенного HTTPS трафика поверх стандартного TLS",
