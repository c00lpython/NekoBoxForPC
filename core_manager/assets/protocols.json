      "insecure": { "type": "bool", "description": "Игнорировать ошибки TLS сертификата", "default": false }
    }
  },
  "wireguard": {
    "description": "WireGuard — современный VPN туннель на UDP с минимальной задержкой",
    "properties": {
      "server": { "type": "string", "description": "Адрес эндпоинта (IP или домен сервера)", "default": "127.0.0.1" },
      "server_port": { "type": "u16", "description": "Порт эндпоинта", "default": 51820 },
      "private_key": { "type": "string", "description": "Приватный ключ клиента (Base64)", "default": "" },
      "peer_public_key": { "type": "string", "description": "Публичный ключ сервера (Base64)", "default": "" },
      "pre_shared_key": { "type": "string", "description": "Pre-shared key (PSK, опционально)", "default": "" },
      "local_address": { "type": "string", "description": "Локальный IP интерфейса в туннеле (например: 172.16.0.2/32)", "default": "172.16.0.2/32" },
      "mtu": { "type": "u16", "description": "Размер MTU сетевого интерфейса", "default": 1420 },
      "reserved": { "type": "array", "description": "Резервные байты (для Cloudflare WARP [0, 0, 0])", "default": [0, 0, 0] }
    }
  },
  "amneziawg": {
    "description": "AmneziaWG (AWG) — протокол WireGuard с параметрами маскировки от сигнатурного анализа и ТСПУ",
    "properties": {
      "server": { "type": "string", "description": "Адрес эндпоинта (IP или домен)", "default": "127.0.0.1" },
      "server_port": { "type": "u16", "description": "Порт эндпоинта", "default": 51820 },
      "private_key": { "type": "string", "description": "Приватный ключ клиента (Base64)", "default": "" },
      "peer_public_key": { "type": "string", "description": "Публичный ключ сервера (Base64)", "default": "" },
      "pre_shared_key": { "type": "string", "description": "Pre-shared key (PSK)", "default": "" },
      "local_address": { "type": "string", "description": "Локальный IP интерфейса (например: 172.16.0.2/32)", "default": "172.16.0.2/32" },
      "mtu": { "type": "u16", "description": "Размер MTU пакета", "default": 1420 },
      "jc": { "type": "u16", "description": "Junk packet count (Количество мусорных пакетов при инициализации)", "default": 4 },
      "jmin": { "type": "u16", "description": "Junk packet minimum size (Минимальный размер мусорного пакета)", "default": 40 },
      "jmax": { "type": "u16", "description": "Junk packet maximum size (Максимальный размер мусорного пакета)", "default": 70 },
      "s1": { "type": "u16", "description": "Init packet junk size (Размер мусорного префикса первого пакета)", "default": 15 },
      "s2": { "type": "u16", "description": "Response packet junk size (Размер мусорного префикса ответного пакета)", "default": 15 },
      "h1": { "type": "u32", "description": "Init packet magic header (Магический заголовок пакета инициализации)", "default": 1 },
      "h2": { "type": "u32", "description": "Response packet magic header (Магический заголовок пакета ответа)", "default": 2 },
      "h3": { "type": "u32", "description": "Cookie packet magic header (Магический заголовок cookie пакета)", "default": 3 },
      "h4": { "type": "u32", "description": "Transport packet magic header (Магический заголовок транспортного пакета)", "default": 4 }
    }
  },
