      "transport_type": { "type": "string", "description": "Тип транспорта (tcp, ws, grpc)", "default": "tcp" },
      "transport_path": { "type": "string", "description": "Путь запроса (Path)", "default": "" }
    }
  },
  "shadowsocks": {
    "description": "Shadowsocks (SS) — быстрый надежный шифрованный SOCKS5-прокси",
    "properties": {
      "server": { "type": "string", "description": "Адрес сервера (IP или домен)", "default": "127.0.0.1" },
