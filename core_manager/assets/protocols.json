      "password": { "type": "string", "description": "Пароль подключения (или base64 ключ для SS-2022)", "default": "" },
      "plugin": { "type": "string", "description": "SIP003 плагин обфускации (obfs-local, v2ray-plugin или пусто)", "default": "" },
      "plugin_opts": { "type": "string", "description": "Опции плагина обфускации", "default": "" },
      "udp_over_tcp": { "type": "bool", "description": "Инкапсуляция UDP через TCP туннель", "default": false }
    }
  },
  "hysteria2": {
    "description": "Hysteria 2 — высокоскоростной UDP прокси на модифицированном протоколе QUIC",
    "properties": {
      "server": { "type": "string", "description": "Адрес сервера (IP или домен)", "default": "127.0.0.1" },
