  },
  "balancer": {
    "_special": "balancer",
    "description": "Balancer — интеллектуальный балансировщик нагрузки с автовыбором наилучшего узла",
    "properties": {
      "group": { "type": "string", "description": "Группа узлов для балансировки (или ALL для всех)", "default": "ALL" },
      "strategy": { "type": "string", "description": "Алгоритм балансировки: urltest (по пингу), selector (ручной), fallback (резерв)", "default": "urltest" },
